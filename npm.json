{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Keep dependencies on all active branches up-to-date",
    "extends": [
        "config:recommended",
        "schedule:weekends",
        ":disableRateLimiting"
    ],
    "timezone": "Europe/Zurich",
    "baseBranchPatterns": [
        "master",
        "release/12.0",
        "release/10.0"
    ],
    "labels": [
        "dependencies"
    ],
    "semanticCommits": "disabled",
    "postUpdateOptions": ["pnpmDedupe"],
    "customManagers": [
        {
            "description": "Update npm global packages in Dockerfile",
            "customType": "regex",
            "managerFilePatterns": [
                "/Dockerfile/"
            ],
            "matchStrings": [
                "RUN\\s+npm install -g (?<depName>\\S+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "semver"
        }
    ],
    "packageRules": [
        {
            "description": "Do not update own packages",
            "matchPackageNames": [
                "@axonivy/*"
            ],
            "enabled": false
        },
        {
            "description": "Disable major upgrades for release branches",
            "matchBaseBranches": [
                "release/12.0",
                "release/10.0"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "description": "Sync updates of Playwright package and its Docker image.",
            "matchPackageNames": [
                "@playwright/test",
                "mcr.microsoft.com/playwright"
            ],
            "automerge": true,
            "groupName": "playwright.tests"
        },
        {
            "description": "Disable all non easy upgradable packages",
            "matchDepNames": [
                "@codingame/*", 
                "monaco-editor*", 
                "monaco-languageclient", 
                "@eclipse-glsp/*",
                "sprotty*",
                "inversify"
            ],
            "enabled": false
        },
        {
            "description": "Disable jakarta version upgrades",
            "matchPackageNames": [
                "com.axonivy.ivy.api:ivy-project-parent",
                "com.axonivy.ivy.ci:project-build-plugin",
                "com.axonivy.ivy.webtest:web-tester",
                "com.axonivy.ivy.api:ivy-api-bom"
            ],
            "allowedVersions": "14.0.0-jakarta-SNAPSHOT",
            "enabled": false
        }
    ]
}
